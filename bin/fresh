#!/usr/bin/env zsh

emulate -L zsh
unsetopt xtrace bg_nice

usage() {
  echo "Usage: fresh"
}

print_status() {
  local color="$1"
  local message="$2"

  print -r -- "${color}${message}${CAIOFBPA_COLOR_RESET}"
}

find_default_branch() {
  local repo="$1"
  local default_ref

  default_ref=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  if [[ -z "$default_ref" ]]; then
    default_ref=$(git -C "$repo" for-each-ref --count=1 --format='%(refname:short)' 'refs/remotes/*/HEAD' 2>/dev/null)
  fi

  print -r -- "${default_ref#*/}"
}

run_pull() {
  local repo="$1"
  local branch="$2"
  local upstream="$3"
  local output_file="$4"
  local before_head after_head

  emulate -L zsh
  unsetopt xtrace bg_nice

  before_head=$(git -C "$repo" rev-parse HEAD 2>/dev/null) || {
    print_status "${CAIOFBPA_COLOR_ERROR}" "${repo} (unable to read HEAD)" > "$output_file"
    return
  }

  if ! git -C "$repo" pull --ff-only >/dev/null 2>&1; then
    print_status "${CAIOFBPA_COLOR_ERROR}" "${repo} (failed to pull $branch <- $upstream)" > "$output_file"
    return
  fi

  after_head=$(git -C "$repo" rev-parse HEAD 2>/dev/null) || {
    print_status "${CAIOFBPA_COLOR_ERROR}" "${repo} (unable to read HEAD after pull)" > "$output_file"
    return
  }

  if [[ "$before_head" == "$after_head" ]]; then
    print_status "${CAIOFBPA_COLOR_SUCCESS}" "${repo} (already up to date)" > "$output_file"
    return
  fi

  print -r -- "${repo} (pulled $branch <- $upstream)" > "$output_file"
}

queue_pull_for_repo() {
  local repo="$1"
  local branch upstream default_branch output_file

  if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    return
  fi

  branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null) || {
    print_status "${CAIOFBPA_COLOR_ERROR}" "${repo} (detached HEAD)"
    return
  }

  default_branch=$(find_default_branch "$repo")
  if [[ -n "$default_branch" && "$branch" != "$default_branch" ]]; then
    print_status "${CAIOFBPA_COLOR_WARNING}" "${repo} ($branch is not the default branch: $default_branch)"
    return
  fi

  if [[ -n "$(git -C "$repo" status --porcelain --untracked-files=normal 2>/dev/null)" ]]; then
    print_status "${CAIOFBPA_COLOR_ERROR}" "${repo} (dirty)"
    return
  fi

  upstream=$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) || {
    print_status "${CAIOFBPA_COLOR_ERROR}" "${repo} (no upstream for $branch)"
    return
  }

  output_file="${output_dir}/pull-${#pull_output_files[@]}.log"
  run_pull "$repo" "$branch" "$upstream" "$output_file" 2>/dev/null &
  pull_pids+=("$!")
  pull_output_files+=("$output_file")
}

print_pull_results() {
  local index

  if (( ${#pull_pids[@]} == 0 )); then
    return
  fi

  for (( index = 1; index <= ${#pull_pids[@]}; index++ )); do
    wait "${pull_pids[index]}"
    cat "${pull_output_files[index]}"
  done
}

while (( $# > 0 )); do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
  shift
done

typeset output_dir
typeset -a repos
typeset -a pull_pids pull_output_files

repos=(./*(/N) ./*/*(/N))

if (( ${#repos[@]} == 0 )); then
  echo "No git repositories found under $PWD"
  exit 0
fi

output_dir=$(mktemp -d "${TMPDIR:-/tmp}/fresh.XXXXXX") || exit 1
trap 'rm -rf "$output_dir"' EXIT

for repo in "${repos[@]}"; do
  queue_pull_for_repo "$repo"
done

print_pull_results
